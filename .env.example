# Copy to server/.env or set these in your host's dashboard.

# REQUIRED in production: a long random string used to sign login tokens.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

PORT=4000

# Where the SQLite database and uploaded receipts live. Mount a persistent disk here in production.
DATA_DIR=./data

# Create demo users and groups on an empty database (demo@splitmate.app / demo1234). Set to false for a real launch.
SEED_DEMO=true

# Only needed if the frontend is hosted on a different domain than the API (comma-separated).
# CLIENT_ORIGIN=https://your-frontend.vercel.app
